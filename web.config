<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS 設定:部署到 https://trcom.texray.com/info/ 時使用。
  GitHub Pages 與 Azure Static Web Apps 會忽略這個檔案。

  每個 mimeMap 前面都先 remove:如果伺服器本身已經定義了同一個副檔名,
  只寫 mimeMap 會出現「HTTP 500.19 - Cannot add duplicate collection entry」,整個網站打不開。
  先 remove 再加,不管伺服器有沒有內建都能正確運作。

  存取控制(Windows 驗證、停用匿名驗證)刻意不寫在這裡:驗證與 ipSecurity 區段
  在伺服器層級預設是鎖定的,寫在 web.config 會造成 500.19。請在 IIS 管理員設定,
  步驟見 deploy/README.md。
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- 缺少這個對應,data/*.json 會全部 404,網頁打得開但每一頁都顯示載入失敗 -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <!-- favicon.svg -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    <!-- 上層站台若自訂了預設文件清單,確保 /info/ 仍會開 index.html -->
    <defaultDocument enabled="true">
      <files>
        <remove value="index.html" />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
